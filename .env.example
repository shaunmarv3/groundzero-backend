# ============================================================
# GroundZero — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------ Server -----------------------------------------------
# Host and port for Uvicorn
APP_HOST=0.0.0.0
APP_PORT=8000

# Environment: "development" | "production"
APP_ENV=development

# ------ Model ------------------------------------------------
# SigLIP 2 vision+text encoder backbone (frozen, ~400M params, ~800MB VRAM)
# Options (speed vs quality tradeoff):
#   google/siglip2-large-patch16-256     (303M, fastest)
#   google/siglip2-so400m-patch14-384    (400M, recommended ✅)
#   google/siglip2-giant-opt-patch16-384 (2B, slower, marginal gain)
SIGLIP2_MODEL_ID=google/siglip2-so400m-patch14-384

# HuggingFace Hub repo where trained weights are stored
# Format: "username/repo-name"
HF_MODEL_REPO=your-hf-username/groundzero-weights

# Local path where the checkpoint is cached after download
# Leave blank to use HuggingFace default cache (~/.cache/huggingface)
MODEL_CACHE_DIR=

# Which device to run inference on: "cuda" | "cpu" | "auto"
# "auto" will use CUDA if available, otherwise CPU
DEVICE=auto

# ------ Inference Config -------------------------------------
# Frames per second for coarse pass (Pass 1)
COARSE_FPS=1.0

# Frames per second for fine-grained re-sampling region (Pass 2)
FINE_FPS=4.0

# Seconds of padding around coarse prediction for fine re-sample
FINE_PADDING_SEC=5.0

# Confidence threshold below which "event not found" is returned
CONFIDENCE_THRESHOLD=0.4

# Maximum video duration (seconds) accepted by /predict endpoint
# Videos longer than this will be rejected with HTTP 413
MAX_VIDEO_DURATION_SEC=7200

# ------ CORS -------------------------------------------------
# Comma-separated list of allowed frontend origins
# Example: http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ------ Weights & Biases (optional, for eval logging) --------
WANDB_API_KEY=
WANDB_PROJECT=groundzero
WANDB_ENTITY=

# ------ HuggingFace Auth (needed to push/pull private repos) -
HF_TOKEN=

# ------ File Upload ------------------------------------------
# Temporary directory for uploaded video files
UPLOAD_DIR=/tmp/groundzero_uploads

# Max upload size in MB (enforced by FastAPI middleware)
MAX_UPLOAD_SIZE_MB=2000
